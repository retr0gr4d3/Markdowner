<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Markdowner.Views.FormattingHelpWindow"
        Title="Formatting Help"
        Width="1080" Height="820"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeLow}">

  <DockPanel>

    <Border Classes="chrome" DockPanel.Dock="Top" Padding="14,10">
      <DockPanel>
        <TextBox x:Name="FilterBox"
                 DockPanel.Dock="Right"
                 Width="260"
                 Watermark="Filter formats..."
                 VerticalAlignment="Center" />

        <StackPanel Spacing="2">
          <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="SubheadingText" Classes="dim" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Classes="statusbar" DockPanel.Dock="Bottom">
      <DockPanel>
        <TextBlock x:Name="CountText" Classes="dim" DockPanel.Dock="Left" />
        <TextBlock Classes="dim" HorizontalAlignment="Right"
                   Text="Every example is rendered by the live preview engine." />
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ContentHost" Margin="14" Spacing="20" />
    </ScrollViewer>

  </DockPanel>
</Window>
